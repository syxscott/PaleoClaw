{
  "name": "@paleoclaw/gateway-client",
  "version": "2026.10.5",
  "description": "Reference WebSocket client for the paleoclaw Gateway protocol",
  "keywords": [
    "client",
    "gateway",
    "paleoclaw",
    "websocket"
  ],
  "homepage": "https://github.com/syxscott/PaleoClaw#readme",
  "bugs": {
    "url": "https://github.com/syxscott/PaleoClaw/issues"
  },
  "license": "MIT",
  "author": "paleoclaw Foundation (https://openclaw.org)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syxscott/PaleoClaw.git",
    "directory": "packages/gateway-client"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./browser": {
      "types": "./dist/browser.d.mts",
      "import": "./dist/browser.mjs",
      "default": "./dist/browser.mjs"
    },
    "./readiness": {
      "types": "./dist/readiness.d.mts",
      "import": "./dist/readiness.mjs",
      "default": "./dist/readiness.mjs"
    },
    "./scope-upgrade": {
      "types": "./dist/scope-upgrade.d.mts",
      "import": "./dist/scope-upgrade.mjs",
      "default": "./dist/scope-upgrade.mjs"
    },
    "./timeouts": {
      "types": "./dist/timeouts.d.mts",
      "import": "./dist/timeouts.mjs",
      "default": "./dist/timeouts.mjs"
    },
    "./websocket-data": {
      "types": "./dist/websocket-data.d.mts",
      "import": "./dist/websocket-data.mjs",
      "default": "./dist/websocket-data.mjs"
    }
  },
  "scripts": {
    "build": "node --import ../../scripts/tsx.mjs ../../scripts/build-workspace-package.mts gateway-client"
  },
  "dependencies": {
    "@paleoclaw/gateway-protocol": "workspace:*",
    "ipaddr.js": "2.5.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@paleoclaw/normalization-core": "workspace:*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "paleoclaw": {
    "release": {
      "publishToNpm": true
    }
  }
}
