{
  "name": "@paleoclaw/mxc-sandbox",
  "version": "2026.10.5",
  "description": "paleoclaw MXC sandbox execution plugin for MXC-capable hosts",
  "repository": {
    "type": "git",
    "url": "https://github.com/syxscott/PaleoClaw"
  },
  "type": "module",
  "devDependencies": {
    "@paleoclaw/plugin-sdk": "workspace:*"
  },
  "dependencies": {
    "@microsoft/mxc-sdk": "0.9.0",
    "zod": "4.6.7"
  },
  "paleoclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "PaleoHub:@paleoclaw/mxc-sandbox",
      "npmSpec": "@paleoclaw/mxc-sandbox",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.6.11"
    },
    "compat": {
      "pluginApi": ">=2026.10.5"
    },
    "build": {
      "openclawVersion": "2026.10.5",
      "bundledDist": false,
      "staticAssets": [
        {
          "source": "./src/mxc-spawn-launcher.mjs",
          "output": "mxc-spawn-launcher.mjs"
        }
      ]
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
