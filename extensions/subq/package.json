{
  "name": "@paleoclaw/subq",
  "version": "2026.10.3",
  "description": "paleoclaw SubQ Snap decision provider",
  "repository": {
    "type": "git",
    "url": "https://github.com/paleoclaw/paleoclaw"
  },
  "type": "module",
  "devDependencies": {
    "@paleoclaw/plugin-sdk": "workspace:*"
  },
  "paleoclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@paleoclaw/subq",
      "clawhubSpec": "PaleoHub:@paleoclaw/subq",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.10.3"
    },
    "compat": {
      "pluginApi": ">=2026.10.3"
    },
    "build": {
      "bundledDist": false,
      "openclawVersion": "2026.10.3"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
