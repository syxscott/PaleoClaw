{
  "name": "@paleoclaw/amazon-bedrock-provider",
  "version": "2026.10.5",
  "description": "paleoclaw Amazon Bedrock provider plugin with model discovery, embeddings, and guardrail support.",
  "repository": {
    "type": "git",
    "url": "https://github.com/paleoclaw/paleoclaw"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-bedrock": "3.1150.0",
    "@aws-sdk/client-bedrock-runtime": "3.1150.0",
    "@aws-sdk/credential-provider-node": "3.972.86",
    "@smithy/node-http-handler": "4.12.1",
    "@smithy/types": "4.19.0"
  },
  "devDependencies": {
    "@paleoclaw/plugin-sdk": "workspace:*"
  },
  "paleoclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "PaleoHub:@paleoclaw/amazon-bedrock-provider",
      "npmSpec": "@paleoclaw/amazon-bedrock-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12-beta.1"
    },
    "compat": {
      "pluginApi": ">=2026.10.5"
    },
    "build": {
      "openclawVersion": "2026.10.5",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
