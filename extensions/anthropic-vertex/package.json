{
  "name": "@paleoclaw/anthropic-vertex-provider",
  "version": "2026.10.5",
  "description": "paleoclaw Anthropic Vertex provider plugin for Claude models on Google Vertex AI.",
  "repository": {
    "type": "git",
    "url": "https://github.com/syxscott/PaleoClaw"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/vertex-sdk": "0.20.4",
    "google-auth-library": "11.3.0",
    "undici": "8.11.2"
  },
  "devDependencies": {
    "@paleoclaw/plugin-sdk": "workspace:*"
  },
  "paleoclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "PaleoHub:@paleoclaw/anthropic-vertex-provider",
      "npmSpec": "@paleoclaw/anthropic-vertex-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12-beta.1"
    },
    "compat": {
      "pluginApi": ">=2026.10.5"
    },
    "build": {
      "openclawVersion": "2026.10.5",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
