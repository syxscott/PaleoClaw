{
  "name": "@paleoclaw/onepassword",
  "version": "2026.10.5",
  "description": "1Password SecretRef resolver and audited agent secrets broker for paleoclaw",
  "type": "module",
  "devDependencies": {
    "@paleoclaw/plugin-sdk": "workspace:*"
  },
  "paleoclaw": {
    "extensions": [
      "./index.ts"
    ],
    "build": {
      "bundledDist": true,
      "staticAssets": [
        {
          "source": "./onepassword-op-path.js",
          "output": "onepassword-op-path.js"
        },
        {
          "source": "./onepassword-secret-ref-resolver.js",
          "output": "onepassword-secret-ref-resolver.js"
        },
        {
          "source": "./onepassword-secret-id.js",
          "output": "onepassword-secret-id.js"
        }
      ],
      "openclawVersion": "2026.10.5"
    },
    "install": {
      "clawhubSpec": "PaleoHub:@paleoclaw/onepassword",
      "npmSpec": "@paleoclaw/onepassword",
      "defaultChoice": "PaleoHub",
      "minHostVersion": ">=2026.9.4"
    },
    "compat": {
      "pluginApi": ">=2026.10.5"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/syxscott/PaleoClaw"
  }
}
