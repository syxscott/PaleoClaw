{
  "name": "@paleoclaw/openshell-sandbox",
  "version": "2026.10.5",
  "description": "paleoclaw sandbox backend for the NVIDIA OpenShell CLI with mirrored local workspaces and SSH command execution.",
  "repository": {
    "type": "git",
    "url": "https://github.com/syxscott/PaleoClaw"
  },
  "type": "module",
  "dependencies": {
    "@openclaw/fs-safe": "0.26.8",
    "p-limit": "7.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@paleoclaw/plugin-sdk": "workspace:*"
  },
  "paleoclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "PaleoHub:@paleoclaw/openshell-sandbox",
      "npmSpec": "@paleoclaw/openshell-sandbox",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12-beta.1"
    },
    "compat": {
      "pluginApi": ">=2026.10.5"
    },
    "build": {
      "openclawVersion": "2026.10.5",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
