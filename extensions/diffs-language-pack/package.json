{
  "name": "@paleoclaw/diffs-language-pack",
  "version": "2026.10.5",
  "description": "paleoclaw diffs viewer syntax highlighting language pack",
  "repository": {
    "type": "git",
    "url": "https://github.com/paleoclaw/paleoclaw"
  },
  "type": "module",
  "devDependencies": {
    "@paleoclaw/plugin-sdk": "workspace:*"
  },
  "paleoclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@paleoclaw/diffs-language-pack",
      "clawhubSpec": "PaleoHub:@paleoclaw/diffs-language-pack",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.27"
    },
    "compat": {
      "pluginApi": ">=2026.10.5"
    },
    "assetScripts": {
      "build": "node --import tsx ../../scripts/build-diffs-viewer-runtime.mts full"
    },
    "build": {
      "bundledDist": false,
      "openclawVersion": "2026.10.5",
      "staticAssets": [
        {
          "source": "./assets/viewer-runtime.js",
          "output": "assets/viewer-runtime.js"
        }
      ]
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
