{
  "name": "@paleoclaw/logbook",
  "version": "2026.10.5",
  "description": "paleoclaw automatic work journal plugin",
  "type": "module",
  "devDependencies": {
    "@paleoclaw/plugin-sdk": "workspace:*"
  },
  "peerDependencies": {
    "paleoclaw": ">=2026.10.5"
  },
  "peerDependenciesMeta": {
    "paleoclaw": {
      "optional": true
    }
  },
  "paleoclaw": {
    "build": {
      "bundledDist": true,
      "staticAssets": [
        {
          "source": "./src/logbook-schema.postgres.sql",
          "output": "./src/logbook-schema.postgres.sql"
        }
      ],
      "workerEntries": [
        "./src/store.worker.ts"
      ],
      "openclawVersion": "2026.10.5"
    },
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "PaleoHub:@paleoclaw/logbook",
      "npmSpec": "@paleoclaw/logbook",
      "defaultChoice": "PaleoHub",
      "minHostVersion": ">=2026.9.5"
    },
    "compat": {
      "pluginApi": ">=2026.10.5"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/syxscott/PaleoClaw"
  }
}
