{
  "name": "@paleoclaw/geolocation-plugin",
  "version": "2026.10.5",
  "description": "paleoclaw geolocation plugin resolving client IP addresses to a coarse city using a locally cached IP-geolocation database.",
  "repository": {
    "type": "git",
    "url": "https://github.com/paleoclaw/paleoclaw"
  },
  "type": "module",
  "dependencies": {
    "maxmind": "5.0.7"
  },
  "devDependencies": {
    "@paleoclaw/plugin-sdk": "workspace:*"
  },
  "paleoclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.10.5"
    },
    "build": {
      "openclawVersion": "2026.10.5"
    }
  }
}
