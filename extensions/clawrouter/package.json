{
  "name": "@paleoclaw/clawrouter",
  "version": "2026.10.5",
  "private": true,
  "description": "paleoclaw ClawRouter plugin",
  "type": "module",
  "devDependencies": {
    "@paleoclaw/plugin-sdk": "workspace:*",
    "@solidjs/compiler": "2.0.0-rc.14",
    "esbuild": "0.28.2"
  },
  "paleoclaw": {
    "extensions": [
      "./index.ts"
    ],
    "controlUi": "./src/control-ui.tsx",
    "assetScripts": {
      "build": "cd ../.. && node --import ./scripts/tsx.mjs scripts/build-plugin-control-ui.mts extensions/clawrouter",
      "copy": "cd ../.. && node --import ./scripts/tsx.mjs scripts/build-plugin-control-ui.mts extensions/clawrouter --copy",
      "buildOutputs": [
        "dist/openclaw.plugin.json"
      ]
    }
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.14",
    "solid-js": "2.0.0-rc.14"
  }
}
