{
  "name": "@paleoclaw/code-mode-quickjs",
  "version": "2026.10.5",
  "private": true,
  "description": "QuickJS executor for paleoclaw Code Mode",
  "type": "module",
  "dependencies": {
    "quickjs-wasi": "3.6.2"
  },
  "devDependencies": {
    "@paleoclaw/plugin-sdk": "workspace:*"
  },
  "paleoclaw": {
    "extensions": [
      "./index.ts"
    ],
    "build": {
      "workerEntries": [
        "./src/code-mode.worker.ts"
      ],
      "staticAssets": [
        {
          "source": "./node_modules/quickjs-wasi/quickjs.wasm",
          "output": "assets/quickjs.wasm"
        },
        {
          "source": "./node_modules/quickjs-wasi/extensions/encoding/encoding.so",
          "output": "assets/encoding.so"
        }
      ]
    }
  }
}
