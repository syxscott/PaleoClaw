{
  "name": "@paleoclaw/tlon",
  "version": "1.8.0",
  "description": "paleoclaw Tlon/Urbit channel plugin",
  "type": "module",
  "dependencies": {
    "@tloncorp/api": "0.0.13",
    "@tloncorp/tlon-skill": "0.2.2",
    "@urbit/aura": "^3.0.0",
    "zod": "^4.3.6"
  },
  "paleoclaw": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "tlon",
      "label": "Tlon",
      "selectionLabel": "Tlon (Urbit)",
      "docsPath": "/channels/tlon",
      "docsLabel": "tlon",
      "blurb": "decentralized messaging on Urbit; install the plugin to enable.",
      "order": 90,
      "quickstartAllowFrom": true
    },
    "install": {
      "npmSpec": "@paleoclaw/tlon",
      "localPath": "extensions/tlon",
      "defaultChoice": "npm"
    }
  }
}
