{
  "name": "@paleoclaw/cloudflare",
  "version": "2026.10.5",
  "description": "Cloudflare R2 storage provider for OpenClaw.",
  "repository": {
    "type": "git",
    "url": "https://github.com/syxscott/PaleoClaw"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0"
  },
  "devDependencies": {
    "@paleoclaw/plugin-sdk": "workspace:*"
  },
  "paleoclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "PaleoHub:@paleoclaw/cloudflare",
      "npmSpec": "@paleoclaw/cloudflare",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.9.7"
    },
    "compat": {
      "pluginApi": ">=2026.10.5"
    },
    "build": {
      "openclawVersion": "2026.10.5"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
