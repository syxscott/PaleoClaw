{
  "name": "@paleoclaw/memory-wiki",
  "version": "2026.10.5",
  "description": "paleoclaw persistent wiki plugin",
  "type": "module",
  "dependencies": {
    "mdast-util-from-markdown": "2.1.0",
    "typebox": "1.3.37",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@paleoclaw/memory-core": "workspace:*",
    "@paleoclaw/plugin-sdk": "workspace:*",
    "paleoclaw": "workspace:*"
  },
  "peerDependencies": {
    "paleoclaw": ">=2026.10.5"
  },
  "peerDependenciesMeta": {
    "paleoclaw": {
      "optional": true
    }
  },
  "paleoclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "PaleoHub:@paleoclaw/memory-wiki",
      "npmSpec": "@paleoclaw/memory-wiki",
      "defaultChoice": "PaleoHub",
      "minHostVersion": ">=2026.9.4"
    },
    "compat": {
      "pluginApi": ">=2026.10.5"
    },
    "build": {
      "bundledDist": true,
      "openclawVersion": "2026.10.5",
      "workerEntries": [
        "./src/query-reader.worker.ts"
      ]
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/syxscott/PaleoClaw"
  }
}
