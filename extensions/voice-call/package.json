{
  "name": "@paleoclaw/voice-call",
  "version": "2026.10.5",
  "description": "paleoclaw voice-call plugin for Twilio, Telnyx, and Plivo phone calls.",
  "repository": {
    "type": "git",
    "url": "https://github.com/syxscott/PaleoClaw"
  },
  "type": "module",
  "dependencies": {
    "typebox": "1.3.37",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@paleoclaw/plugin-sdk": "workspace:*"
  },
  "peerDependencies": {
    "paleoclaw": ">=2026.10.5"
  },
  "peerDependenciesMeta": {
    "paleoclaw": {
      "optional": true
    }
  },
  "paleoclaw": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-api.ts",
    "install": {
      "clawhubSpec": "PaleoHub:@paleoclaw/voice-call",
      "npmSpec": "@paleoclaw/voice-call",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.10"
    },
    "compat": {
      "pluginApi": ">=2026.10.5"
    },
    "build": {
      "openclawVersion": "2026.10.5"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
