{
  "name": "@paleoclaw/zalo",
  "version": "2026.10.5",
  "description": "paleoclaw Zalo channel plugin for bot and webhook chats.",
  "repository": {
    "type": "git",
    "url": "https://github.com/syxscott/PaleoClaw"
  },
  "type": "module",
  "devDependencies": {
    "@paleoclaw/plugin-sdk": "workspace:*"
  },
  "peerDependencies": {
    "paleoclaw": ">=2026.10.5"
  },
  "peerDependenciesMeta": {
    "paleoclaw": {
      "optional": true
    }
  },
  "paleoclaw": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "setupFeatures": {
      "configPromotion": true
    },
    "channel": {
      "id": "zalo",
      "configuredState": {
        "env": {
          "anyOf": [
            "ZALO_BOT_TOKEN"
          ]
        }
      },
      "label": "Zalo",
      "selectionLabel": "Zalo (Bot API)",
      "docsPath": "/channels/zalo",
      "docsLabel": "zalo",
      "blurb": "Vietnam-focused messaging platform with Bot API.",
      "aliases": [
        "zl"
      ],
      "order": 80,
      "quickstartAllowFrom": true,
      "setup": {
        "fields": [
          {
            "key": "token",
            "kind": "string",
            "sensitive": true,
            "cli": {
              "flags": "--token <token>",
              "description": "Zalo bot token"
            }
          },
          {
            "key": "tokenFile",
            "kind": "string",
            "sensitive": true,
            "cli": {
              "flags": "--token-file <path>",
              "description": "Zalo bot token file"
            }
          },
          {
            "key": "useEnv",
            "kind": "boolean",
            "cli": {
              "flags": "--use-env",
              "description": "Use ZALO_BOT_TOKEN"
            },
            "envVars": [
              "ZALO_BOT_TOKEN"
            ]
          }
        ]
      }
    },
    "install": {
      "clawhubSpec": "PaleoHub:@paleoclaw/zalo",
      "npmSpec": "@paleoclaw/zalo",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.9.8"
    },
    "compat": {
      "pluginApi": ">=2026.10.5"
    },
    "build": {
      "openclawVersion": "2026.10.5"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
