{
  "name": "@paleoclaw/onnx",
  "version": "2026.10.5",
  "description": "Local ONNX decision models for paleoclaw",
  "repository": {
    "type": "git",
    "url": "https://github.com/paleoclaw/paleoclaw"
  },
  "type": "module",
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "typebox": "1.3.37"
  },
  "optionalDependencies": {
    "onnxruntime-node": "1.30.0"
  },
  "devDependencies": {
    "@paleoclaw/plugin-sdk": "workspace:*"
  },
  "paleoclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "PaleoHub:@paleoclaw/onnx",
      "npmSpec": "@paleoclaw/onnx",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.9.6"
    },
    "compat": {
      "pluginApi": ">=2026.10.5"
    },
    "build": {
      "bundledDist": false,
      "openclawVersion": "2026.10.5",
      "workerEntries": [
        "./src/inference.worker.ts"
      ],
      "staticAssets": [
        {
          "source": "scripts/export-gliclass-instruct.py",
          "output": "scripts/export-gliclass-instruct.py"
        }
      ]
    },
    "release": {
      "bundleRuntimeDependencies": false,
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
